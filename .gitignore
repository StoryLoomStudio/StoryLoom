# Swift Package Manager
.build/
.swiftpm/
Packages/
Package.resolved

# The Lucide source set.
#
# `icons/` is 1,756 SVGs, and only the handful actually used is vendored into
# Assets.xcassets — which *is* committed, because the app cannot build without
# it. Keeping the whole upstream set out of history means re-vendoring an icon
# needs the download again; that is the intended trade, since the alternative is
# a permanent 1,700-file diff for every icon change.
#
# Delete this line if you would rather have the palette to hand offline.
icons/

# Loose working copies of artwork that live in Assets.xcassets
/*.svg
*.psd

graphify-out/

# Scratch
*.log
*.tmp

.agents/
.codex/
.gemini/
.impeccable/
